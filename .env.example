# Local backend only. Keep actual values in the ignored repository .env.
INSURANCE_BETA_ENABLED=true
AVAILITY_ENVIRONMENT=demo
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
# Existing AVAILITY_API_KEY and AVAILITY_SECRET_KEY are supported aliases.
AVAILITY_SCOPE=healthcare-hipaa-transactions-demo
AVAILITY_BASE_URL=https://api.availity.com/availity
AVAILITY_TOKEN_URL=https://api.availity.com/v1/token
# Production additionally needs the JSON described in AVAILITY_V2_SETUP.md.
AVAILITY_PRACTICE_CONFIG='{}'

# ID.me stays off until a registered sandbox client and exact HTTPS callback
# have passed end-to-end tests. Never commit a real client secret.
IDME_ENABLED=false
IDME_ENVIRONMENT=sandbox
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
IDME_OIDC_DISCOVERY_URL=https://api.idmelabs.com/oidc/.well-known/openid-configuration
# Replace with the exact registered HTTPS callback on a nonproduction deployment.
PUBLIC_BASE_URL=https://replace-with-nonproduction-host.example
IDME_REDIRECT_URI=https://replace-with-nonproduction-host.example/api/patient/idme/callback
# ID.me must assign the policy; bare `openid` is intentionally rejected.
IDME_SCOPE=
