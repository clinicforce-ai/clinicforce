# Local backend only. Keep actual values in the ignored repository .env.
INSURANCE_BETA_ENABLED=true
AVAILITY_ENVIRONMENT=demo
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
# Existing AVAILITY_API_KEY and AVAILITY_SECRET_KEY are supported aliases.
AVAILITY_SCOPE=healthcare-hipaa-transactions-demo
AVAILITY_BASE_URL=https://api.availity.com/availity
AVAILITY_TOKEN_URL=https://api.availity.com/v1/token
# Production additionally needs the JSON described in AVAILITY_V2_SETUP.md.
AVAILITY_PRACTICE_CONFIG='{}'

# Temporary bridge only while AVAILITY_ENVIRONMENT=demo. This is server-side
# and automatically disables itself when AVAILITY_ENVIRONMENT=production.
STEDI_TEST_API_KEY=
# Platform Stedi account. Financial reads also require the practice's verified NPI/TIN.
# Optional secret JSON map of practice ID to integrated-account key. When set,
# unmapped practices cannot fall back to the platform financial account.
STEDI_PRACTICE_API_KEYS=
STEDI_API_KEY=

# ID.me stays off until a registered sandbox client and exact HTTPS callback
# have passed end-to-end tests. Never commit a real client secret.
IDME_ENABLED=false
IDME_ENVIRONMENT=sandbox
IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
IDME_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
IDME_OIDC_DISCOVERY_URL=https://api.idmelabs.com/oidc/.well-known/openid-configuration
# The provisioned sandbox uses ClinicForce's real HTTPS app callback.
PUBLIC_BASE_URL=https://app.clinicforce.ai
IDME_REDIRECT_URI=https://app.clinicforce.ai/api/patient/idme/callback
# ID.me must assign the policy; bare `openid` is intentionally rejected.
IDME_SCOPE=openid tefca
# Sandbox enabling is fail-closed unless at least one designated test patient is listed.
IDME_ALLOWED_PATIENT_IDS=
