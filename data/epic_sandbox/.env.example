# Copy to .env and fill in. Never commit .env.

# Flask session signing key. Must stay stable across debug reloads, or the
# session (and PKCE verifier) is lost between /login and /callback.
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_hex-32

# "sandbox" or "production"
EPIC_ENV=sandbox

# --- Sandbox (Non-Production Client ID from your Epic app registration) ---
EPIC_SANDBOX_CLIENT_ID=4ef6c924-5eed-4d52-980d-0397ec063025
# Defaults to Epic's public sandbox; override only if you need a different one.
# EPIC_SANDBOX_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# --- Production (only works after the app is Ready for Production) ---
EPIC_PROD_CLIENT_ID=4fec48d3-967e-4ea2-a582-7f741f1d997b
# Your health system's R4 FHIR base URL, from Epic's endpoint directory.
EPIC_PROD_FHIR_BASE=

# Must exactly match a URI registered on the Epic app.
# Sandbox: http://localhost:8000/callback
# Production: your HTTPS tunnel or host, e.g. https://your-app.example.com/callback
REDIRECT_URI=http://localhost:8000/callback

# Where exported records and tokens are written.
# DATA_DIR=./export
